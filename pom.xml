<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mibot</groupId>
  <artifactId>discord-music-bot</artifactId>
  <version>1.0-SNAPSHOT</version>

  <name>discord-music-bot</name>
  <url>http://www.example.com</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <repositories>
    <!-- Lavalink releases: youtube-source v2 -->
    <repository>
      <id>lavalink-releases</id>
      <name>Lavalink Releases</name>
      <url>https://maven.lavalink.dev/releases</url>
    </repository>
    <!-- Lavalink snapshots: libdave impl-jni (NativeDaveFactory) -->
    <repository>
      <id>lavalink-snapshots</id>
      <name>Lavalink Snapshots</name>
      <url>https://maven.lavalink.dev/snapshots</url>
    </repository>

    <repository>
      <id>jitpack</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.11</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.30</version>
      <scope>provided</scope>
    </dependency>

    <!-- JDA 6: necesario para el protocolo DAVE (obligatorio desde marzo 2026) -->
    <dependency>
      <groupId>net.dv8tion</groupId>
      <artifactId>JDA</artifactId>
      <version>6.4.1</version>
    </dependency>

    <!-- libdave-jvm: implementación del protocolo DAVE para JDA -->
    <dependency>
      <groupId>moe.kyokobot.libdave</groupId>
      <artifactId>adapter-jda</artifactId>
      <version>0.1.2</version>
    </dependency>

    <!-- impl-jni: provee NativeDaveFactory, necesario para instanciar DAVE -->
    <dependency>
      <groupId>moe.kyokobot.libdave</groupId>
      <artifactId>impl-jni</artifactId>
      <version>0.1.2</version>
    </dependency>

    <!-- Nativas de libdave según tu sistema operativo.
         Descomenta SOLO las que correspondan a donde ejecutas el bot: -->

    <!-- Windows 64-bit (la más común en desarrollo local) -->
    <dependency>
      <groupId>moe.kyokobot.libdave</groupId>
      <artifactId>natives-win-x86-64</artifactId>
      <version>0.1.2</version>
    </dependency>

    <!-- Linux 64-bit (descomenta si despliegas en servidor Linux) -->
    <dependency>
      <groupId>moe.kyokobot.libdave</groupId>
      <artifactId>natives-linux-x86-64</artifactId>
      <version>0.1.2</version>
    </dependency>
 

    <!-- macOS Intel+Apple Silicon (descomenta si usas Mac)
    <dependency>
      <groupId>moe.kyokobot.libdave</groupId>
      <artifactId>natives-darwin</artifactId>
      <version>0.1.2</version>
    </dependency>
    -->

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.12</version>
    </dependency>

    <dependency>
      <groupId>io.github.oriontheprogrammer</groupId>
      <artifactId>bpj</artifactId>
      <version>0.3.1</version>
    </dependency>

    <dependency>
      <groupId>io.github.cdimascio</groupId>
      <artifactId>java-dotenv</artifactId>
      <version>5.2.2</version>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>1.9.22</version>
    </dependency>

    <dependency>
      <groupId>dev.arbjerg</groupId>
      <artifactId>lavaplayer</artifactId>
      <version>2.2.3</version>
    </dependency>

    <dependency>
      <groupId>dev.lavalink.youtube</groupId>
      <artifactId>v2</artifactId>
      <version>1.18.0</version>
    </dependency>
  </dependencies>

<build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.mibot.App</mainClass> </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.github.oriontheprogrammer</groupId>
          <artifactId>bpj-maven-plugin</artifactId>
          <version>0.3.1</version>
          <executions>
            <execution>
              <goals>
                <goal>prepare</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
        </plugins>
    </pluginManagement>
  </build>
</project>